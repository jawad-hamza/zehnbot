# Copy to .env and fill in. Never commit .env.
#
# Generate the three secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                   # SECRET_KEY, DB_PASSWORD
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"         # ENCRYPTION_KEY

# ---- required ----
DB_PASSWORD=
SECRET_KEY=
# Encrypts tenants' AI provider keys in the database. BACK THIS UP. If it is lost or changed,
# every stored key becomes unreadable and has to be re-entered.
ENCRYPTION_KEY=

# First super admin (platform operator). Only used when no super admin exists yet.
# Password: at least 10 characters.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ---- deployment ----
ENVIRONMENT=production
# Public hostname, used by the TLS proxy:  docker compose --profile tls up -d
DOMAIN=chat.example.com
# Where plain-HTTP nginx listens. Keep 127.0.0.1 in production (Caddy fronts it).
# Use 0.0.0.0 only on a trusted LAN / dev machine.
BIND_ADDR=127.0.0.1
HTTP_PORT=3001
WEB_CONCURRENCY=2
LOG_LEVEL=INFO

# ---- multi-tenancy ----
# true = anyone can register a tenant from the dashboard's sign-up page
ALLOW_SIGNUP=false
DEFAULT_SIGNUP_PLAN=free

# ---- platform AI ----
# Answers for bots whose tenant has not entered a key of their own; metered by the tenant's monthly quota.
# Leave the key empty to force every tenant to bring their own.
#
# Provider ids: deepseek, openrouter, openai, anthropic, gemini, groq, mistral, grok, together,
#               fireworks, cerebras, perplexity, custom   (full list: backend/app/services/providers.py)
#
#   DeepSeek (default):  PLATFORM_AI_PROVIDER=deepseek     model optional: deepseek-flash | deepseek-v4-pro
#   OpenRouter:          PLATFORM_AI_PROVIDER=openrouter   PLATFORM_AI_MODEL is REQUIRED, a slug from openrouter.ai/models
#   Your own gateway:    PLATFORM_AI_PROVIDER=custom       PLATFORM_AI_BASE_URL + PLATFORM_AI_MODEL are REQUIRED
PLATFORM_AI_PROVIDER=deepseek
PLATFORM_AI_MODEL=
PLATFORM_AI_API_KEY=
# Optional endpoint override (required for `custom`). May be an internal address, e.g. http://litellm:4000/v1
PLATFORM_AI_BASE_URL=
# Let tenants point a bot at their own OpenAI-compatible endpoint. Such URLs must be public https.
ALLOW_CUSTOM_AI_ENDPOINTS=true

# ---- semantic search (embeddings) ----
# Lets the bot find the right passage even when the visitor words things differently, or writes in
# another language. Paid by the platform; cost is negligible (about a cent to index a full bot).
#
# Embeddings are separate from chat: DeepSeek (and most providers) have no embeddings API.
#   * platform on OpenRouter -> nothing to do, the same key is used (openai/text-embedding-3-small)
#   * platform on DeepSeek   -> set ONE of these, or bots stay on keyword search (which still works):
#         OPENAI_API_KEY=sk-...                                  (OpenAI directly)
#         EMBEDDING_API_KEY=<openrouter key>  EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#                                             EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
ENABLE_EMBEDDINGS=true
EMBEDDING_API_KEY=
# Only for a non-OpenAI, OpenAI-compatible embeddings server. It then needs its own EMBEDDING_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model. Changing it discards stored vectors: run scripts/embed_backfill.py afterwards.
EMBEDDING_DIMENSIONS=1536

# ---- security ----
# Reject widget calls from websites other than the bot's configured domain(s)
ENFORCE_WIDGET_ORIGIN=true
# Extra origins allowed to call the ADMIN api cross-origin. Normally empty: the dashboard is same-origin.
ALLOWED_ORIGINS=
