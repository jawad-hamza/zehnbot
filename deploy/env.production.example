# /opt/zehnbot/.env on the VPS. Copy this file there, fill it in, then:  chmod 600 /opt/zehnbot/.env
# It is read by the deploy scripts and handed to the API container at runtime. It is never in git and
# never baked into an image. Every value here is a placeholder: put real ones only on the server.
#
# Generate the secrets ON THE SERVER:
#   openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-48; echo           -> DB_PASSWORD, SECRET_KEY
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   -> ENCRYPTION_KEY

# ---- where the images come from (GitHub Container Registry, pushed by the workflow) ----
ZEHNBOT_REGISTRY=ghcr.io/jawad-hamza

# ---- required secrets ----
DB_PASSWORD=
SECRET_KEY=
# Encrypts tenants' own AI keys in the database. BACK IT UP somewhere other than this server.
# Lost or changed = every stored tenant key becomes unreadable. Moving an existing database here
# means copying the ENCRYPTION_KEY it was created with, too.
ENCRYPTION_KEY=

# First super admin; only used while no super admin exists. Password: at least 10 characters.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ---- the service ----
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
# The public address of this app (emailed links, Google sign-in). Must be https in production.
PUBLIC_BASE_URL=https://bot.zehnox.com
# The ZEHNOX product page. Only the sign-in pages' logo links there; bot.zehnox.com/ shows ZehnBot's own landing page.
MARKETING_URL=https://zehnox.com/zehnbot

# ---- sign-up ----
ALLOW_SIGNUP=true
DEFAULT_SIGNUP_PLAN=free
# Never true in production: it lets anyone register any address without proving it is theirs.
ALLOW_UNVERIFIED_SIGNUP=false
LANDING_DEMO_BOT=
RATE_LANDING_DEMO_PER_IP_PER_DAY=20

# ---- email (the server's own Postfix, mail.zehnox.com). Password sign-up opens once this works. ----
# Test it after the first deploy:
#   docker exec zehnbot-backend-1 python scripts/send_test_email.py you@example.com
SMTP_HOST=mail.zehnox.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ZehnBot <no-reply@zehnox.com>

# ---- Sign in with Google (optional; both empty = no button) ----
# Authorised redirect URI in Google Cloud: https://bot.zehnox.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- platform AI (see .env.example in the repository for every provider) ----
PLATFORM_AI_PROVIDER=deepseek
PLATFORM_AI_MODEL=
PLATFORM_AI_API_KEY=
PLATFORM_AI_BASE_URL=
ALLOW_CUSTOM_AI_ENDPOINTS=true

# ---- semantic search (optional) ----
OPENAI_API_KEY=
ENABLE_EMBEDDINGS=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- security ----
ENFORCE_WIDGET_ORIGIN=true
ALLOW_LOCALHOST_WIDGET=true
ALLOWED_ORIGINS=
